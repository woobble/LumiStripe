[Unit]
Description=Update LumiStripe from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@LUMI_PROJECT_DIR@
Environment=HOME=@LUMI_SERVICE_HOME@
Environment=LUMI_PROJECT_DIR=@LUMI_PROJECT_DIR@
Environment=LUMI_SERVICE_USER=@LUMI_SERVICE_USER@
Environment=LUMI_UPDATE_STATE_FILE=/var/lib/lumistripe/update/status.json
ExecStart=/bin/bash /usr/local/libexec/lumistripe/deploy/update.sh refs/remotes/lumistripe-upstream/main
TimeoutStartSec=90min


# This unit is a template. deploy/install.sh replaces the @LUMI_*@ values
# with the selected non-root service account and checkout paths.
[Unit]
Description=LumiStripe web dashboard and LED controller
Wants=network-online.target bluetooth.service lumistripe-spotify.service
After=network-online.target bluetooth.service lumistripe-spotify.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@LUMI_SERVICE_USER@
Group=@LUMI_SERVICE_GROUP@
SupplementaryGroups=gpio spi audio
WorkingDirectory=@LUMI_PROJECT_DIR@

# Keep the toolchains available when systemd starts without a login shell.
Environment=PATH=@LUMI_HOME@/.bun/bin:@LUMI_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=LUMI_PROJECT_DIR=@LUMI_PROJECT_DIR@
Environment=LUMI_UPDATE_STATE_FILE=/var/lib/lumistripe/update/status.json
# System services do not inherit the user's PipeWire runtime environment.
# PortAudio's Pulse/ALSA bridge needs this socket to capture the Bluetooth
# monitor, while bluetooth.py also uses it for wpctl/pactl probes.
Environment=XDG_RUNTIME_DIR=/run/user/@LUMI_SERVICE_UID@
EnvironmentFile=/etc/lumistripe/lumistripe-web.env

# The paired network UI uses a sudoers-constrained root helper, so this unit
# cannot use NoNewPrivileges without disabling that authorized operation.
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes

# Rebuild the bundled frontend on every service start so FastAPI serves the
# current UI, manifest, and service worker from its static directory.
# ExecStartPre=/bin/bash -c 'cd "@LUMI_PROJECT_DIR@/apps/lumistripe-web/frontend" && bun run build'

# Match the installer-selected interpreter and production dependency profile.
ExecStart=/bin/bash -c 'exec "@LUMI_HOME@/.local/bin/uv" run --python "@LUMI_PYTHON_VERSION@" --no-dev --extra hardware-gain lumistripe-web --host 127.0.0.1 --hardware'

Restart=on-failure
RestartSec=3
# The runtime exits after cleaning up when its renderer fails or stalls.
# Restart=on-failure brings the complete hardware owner back in that case.
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target

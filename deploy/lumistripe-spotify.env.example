# The Spotify Soloist API key is generated in the Spotify for Developers
# dashboard. Keep this file private (mode 600); it is never committed with a
# real key.
LUMI_SPOTIFY_API_KEY=REPLACE_WITH_SPOTIFY_SOLOIST_API_KEY
LUMI_SPOTIFY_DEVICE_NAME=LumiStripe
LUMI_SPOTIFY_WS=127.0.0.1:9090
LUMI_SPOTIFY_PIPEWIRE_DEVICE=lumistripe_spotify
LUMI_SPOTIFY_DATA_DIR=%h/.local/share/soloist
LUMI_SPOTIFY_CACHE_DIR=%h/.cache/soloist

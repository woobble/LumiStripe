# Copy this file to /etc/lumistripe/lumistripe-web.env and set permissions to 600.
# The installer refuses to start until the placeholder pairing code is replaced.
LUMI_PAIRING_CODE=REPLACE_WITH_4_DIGIT_CODE
# Rust Bluetooth connection limits (input headsets and output speakers).
# LUMI_BLUETOOTH_MAX_INPUTS=1
# LUMI_BLUETOOTH_MAX_OUTPUTS=1
# New installations build commit-matched Rust web, engine, CLI, and deployment
# helper binaries with the native BlueZ and PipeWire providers.
# LUMI_RUST_OUTPUT_BACKEND=spi
# Provider selection is persisted on every installation. Fresh installations
# use the native Rust Spotify Connect receiver; existing legacy configurations
# without this setting are kept on Soloist by the installer.
LUMI_SPOTIFY_BACKEND=librespot
# Common Spotify Connect device name and PipeWire output are configured from
# the dashboard. The output defaults to the dedicated lumistripe_spotify sink.
# LUMI_SPOTIFY_DEVICE_NAME=LumiStripe
# LUMI_SPOTIFY_PIPEWIRE_DEVICE=lumistripe_spotify

# Native librespot state includes credentials, a stable device ID, and cache.
# Keep it private. The default is $HOME/.local/share/lumistripe/spotify.
# LUMI_SPOTIFY_LIBRESPOT_DATA_DIR=/var/lib/lumistripe/spotify
# Legacy Soloist settings are read only when LUMI_SPOTIFY_BACKEND=soloist.
# LUMI_SPOTIFY_WS=127.0.0.1:9090
# LUMI_SPOTIFY_API_KEY is stored in the protected lumistripe-spotify.env file.
# LUMI_SPOTIFY_DATA_DIR=$HOME/.local/share/soloist
# LUMI_SPOTIFY_CACHE_DIR=$HOME/.cache/soloist
# Software runtime disables Spotify unless explicitly enabled. Set true to
# exercise a local provider in simulation.
# LUMISTRIPE_ENABLE_SPOTIFY=true

# Hardware and audio are configured from the dashboard Setup pages and saved
# in the application settings file. The service intentionally starts without
# forcing those values so a fresh installation can be configured safely.
#
# For headless/CLI deployments, uncomment and adapt these examples when
# launching lumistripe-web manually:
#   --pixels 41 --output-backend gpio --chip /dev/gpiochip0
#   --data-pin 10 --clock-pin 11 --audio-source mic --audio-device usb
#   --spi-device /dev/spidev0.0 --spi-speed 1000000

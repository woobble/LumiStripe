# Copy this file to /etc/lumistripe/lumistripe-web.env and set permissions to 600.
# The installer refuses to start until the placeholder pairing code is replaced.
LUMI_PAIRING_CODE=REPLACE_WITH_4_DIGIT_CODE

# Hardware and audio are configured from the dashboard Setup pages and saved
# in the application settings file. The service intentionally starts without
# forcing those values so a fresh installation can be configured safely.
#
# For headless/CLI deployments, uncomment and adapt these examples when
# launching lumistripe-web manually:
#   --pixels 41 --output-backend gpio --chip /dev/gpiochip0
#   --data-pin 10 --clock-pin 11 --audio-source mic --audio-device usb
#   --spi-device /dev/spidev0.0 --spi-speed 1000000

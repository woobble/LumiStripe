# The image only needs the Rust workspace, frontend, and its Docker entrypoint.
# Keeping an allowlist avoids scanning Python packages and generated repo data.
**
!rust/
!rust/**
rust/target/
rust/**/target/
!apps/
!apps/lumistripe-web/
!apps/lumistripe-web/frontend/
!apps/lumistripe-web/frontend/**
apps/lumistripe-web/frontend/node_modules/
apps/lumistripe-web/frontend/dist/
apps/lumistripe-web/frontend/src/lumistripe_web/static/
!deploy/
!deploy/docker/
!deploy/docker/spotify-entrypoint.sh
